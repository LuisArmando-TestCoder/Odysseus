{
  "manifest_version": 3,
  "name": "Odysseus Browser Bridge",
  "version": "0.2.0",
  "key": "",
  "description": "Lets the Odysseus agent run JavaScript in the user's own active tab (Google AI mode, YouTube 'Ask', or any JS-rendered page) and read results back.",
  "permissions": ["scripting", "tabs", "activeTab", "storage", "contextMenus", "commands"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.google.com/*",
    "*://*.google.co.cr/*",
    "*://*.google.com.cr/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.google.com/*",
        "*://*.google.co.cr/*",
        "*://*.google.com.cr/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Odysseus Bridge" },
  "options_page": "options.html",
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1/*",
      "http://localhost/*"
    ]
  },
  "commands": {
    "run-ai-ask": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "Run AI-mode ask on the current active tab"
    }
  }
}