{
  "manifest_version": 3,
  "name": "Odysseus Browser Bridge",
  "version": "0.1.0",
  "description": "Lets the Odysseus agent run JavaScript in the user's own YouTube (or any) tab and read results back — harnesses YouTube 'Ask'/AI mode and any JS-rendered page.",
  "permissions": ["scripting", "tabs", "activeTab", "storage", "contextMenus", "commands"],
  "host_permissions": ["*://*.youtube.com/*", "http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Odysseus Bridge" },
  "options_page": "options.html",
  "commands": {
    "run-ai-ask": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "Run AI-mode ask on the current YouTube tab"
    }
  }
}
